# Copy this file to .env and edit as needed.
# .env is gitignored — never commit secrets.

# ── App identity ──────────────────────────────────────────────────────────────
APP_NAME=python-fastapi
APP_VERSION=0.1.0

# ── Runtime environment ───────────────────────────────────────────────────────
# development | staging | production
#   development → colored console logs, Swagger UI at /docs
#   production  → JSON logs, Swagger UI disabled
ENVIRONMENT=development

# ── Logging ───────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── CORS ──────────────────────────────────────────────────────────────────────
# JSON list of allowed origins. ["*"] permits all origins.
# CORS_ORIGINS=["https://app.example.com","https://admin.example.com"]
CORS_ORIGINS=["*"]

# ── OpenTelemetry (optional) ──────────────────────────────────────────────────
# Tracing is DISABLED when this variable is unset or empty.
# Set to an OTLP/HTTP collector endpoint to enable distributed tracing.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
