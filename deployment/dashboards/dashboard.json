{
  "title": "${{ values.slug }}",
  "tags": ["${{ values.teamName }}", "${{ values.system }}", "webservice"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "links": [
    { "title": "${{ values.system }}", "type": "dashboards", "tags": ["${{ values.system }}"], "asDropdown": true, "includeVars": false, "keepTime": true, "targetBlank": false, "icon": "external link" }
  ],
  "panels": [
    { "id": 1, "type": "row", "title": "Overview", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    { "id": 2, "type": "stat", "title": "Request rate", "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(http_requests_total{namespace=\"__NAMESPACE__\"}[5m]))" } ], "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] } }, "overrides": [] }, "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area", "textMode": "auto" } },
    { "id": 3, "type": "stat", "title": "Error ratio (5xx)", "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "100 * sum(rate(http_requests_total{namespace=\"__NAMESPACE__\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{namespace=\"__NAMESPACE__\"}[5m]))" } ], "fieldConfig": { "defaults": { "unit": "percent", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 } ] } }, "overrides": [] }, "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none", "textMode": "auto" } },
    { "id": 4, "type": "stat", "title": "p95 latency", "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum by(le)(rate(http_request_duration_seconds_bucket{namespace=\"__NAMESPACE__\"}[5m])))" } ], "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.5 }, { "color": "red", "value": 1 } ] } }, "overrides": [] }, "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area", "textMode": "auto" } },
    { "id": 5, "type": "stat", "title": "Ready replicas", "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "kube_deployment_status_replicas_available{namespace=\"__NAMESPACE__\",deployment=\"${{ values.teamName }}-${{ values.componentId }}\"}" } ], "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] }, "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "auto" } },
    { "id": 6, "type": "row", "title": "Traffic & Errors", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 } },
    { "id": 7, "type": "timeseries", "title": "Request rate by handler", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by(handler)(rate(http_requests_total{namespace=\"__NAMESPACE__\"}[5m]))", "legendFormat": "{{handler}}" } ], "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never", "lineWidth": 1 } }, "overrides": [] }, "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } } },
    { "id": 8, "type": "timeseries", "title": "Responses by status class", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by(status)(rate(http_requests_total{namespace=\"__NAMESPACE__\"}[5m]))", "legendFormat": "{{status}}" } ], "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 20, "showPoints": "never", "lineWidth": 1, "stacking": { "mode": "normal", "group": "A" } } }, "overrides": [ { "matcher": { "id": "byName", "options": "5xx" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }, { "matcher": { "id": "byName", "options": "2xx" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] } ] }, "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } } },
    { "id": 9, "type": "row", "title": "Latency", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 } },
    { "id": 10, "type": "timeseries", "title": "Latency percentiles", "gridPos": { "h": 8, "w": 24, "x": 0, "y": 15 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.50, sum by(le)(rate(http_request_duration_seconds_bucket{namespace=\"__NAMESPACE__\"}[5m])))", "legendFormat": "p50" }, { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum by(le)(rate(http_request_duration_seconds_bucket{namespace=\"__NAMESPACE__\"}[5m])))", "legendFormat": "p95" }, { "refId": "C", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.99, sum by(le)(rate(http_request_duration_seconds_bucket{namespace=\"__NAMESPACE__\"}[5m])))", "legendFormat": "p99" } ], "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 5, "showPoints": "never", "lineWidth": 1 } }, "overrides": [] }, "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } } },
    { "id": 11, "type": "row", "title": "Resources", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 } },
    { "id": 12, "type": "timeseries", "title": "CPU usage (cores)", "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"__NAMESPACE__\",container=\"${{ values.teamName }}-${{ values.componentId }}\"}[5m]))", "legendFormat": "cpu" } ], "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never", "lineWidth": 1 } }, "overrides": [] }, "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } } },
    { "id": 13, "type": "timeseries", "title": "Memory: working set vs limit", "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(container_memory_working_set_bytes{namespace=\"__NAMESPACE__\",container=\"${{ values.teamName }}-${{ values.componentId }}\"})", "legendFormat": "working set" }, { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(kube_pod_container_resource_limits{namespace=\"__NAMESPACE__\",container=\"${{ values.teamName }}-${{ values.componentId }}\",resource=\"memory\"})", "legendFormat": "limit" } ], "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never", "lineWidth": 1 } }, "overrides": [ { "matcher": { "id": "byName", "options": "limit" }, "properties": [ { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 8] } }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] } ] }, "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } } },
    { "id": 14, "type": "timeseries", "title": "Open FDs & restarts", "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "process_open_fds{namespace=\"__NAMESPACE__\"}", "legendFormat": "open fds" }, { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(kube_pod_container_status_restarts_total{namespace=\"__NAMESPACE__\",container=\"${{ values.teamName }}-${{ values.componentId }}\"})", "legendFormat": "restarts (total)" } ], "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never", "lineWidth": 1 } }, "overrides": [] }, "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } } },
    { "id": 15, "type": "row", "title": "Logs & Traces", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 } },
    { "id": 16, "type": "logs", "title": "Logs", "gridPos": { "h": 10, "w": 24, "x": 0, "y": 33 }, "datasource": { "type": "loki", "uid": "loki" }, "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "{service_name=\"${{ values.teamName }}-${{ values.componentId }}\"}" } ], "options": { "showTime": true, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending", "dedupStrategy": "none" } },
    { "id": 17, "type": "table", "title": "Recent traces (Tempo)", "gridPos": { "h": 10, "w": 24, "x": 0, "y": 43 }, "datasource": { "type": "tempo", "uid": "tempo" }, "targets": [ { "refId": "A", "datasource": { "type": "tempo", "uid": "tempo" }, "queryType": "traceqlSearch", "limit": 20, "tableType": "traces", "filters": [ { "id": "service-name", "tag": "service.name", "operator": "=", "scope": "resource", "value": ["${{ values.componentId }}"], "valueType": "string" } ] } ], "options": {} }
  ]
}
